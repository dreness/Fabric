 "notes": [
  {
   "id": "99C1B19F-D0BF-47F7-994A-6435062E7A73",
   "note": "# Glyph Carousel (Iterator)\n\nOne **Iterator** runs 73 times. Inside, **Iterator Info** picks a character out of the glyph string with **String Range**, **3D Text Geometry** meshes it, and a **Math Expression** places it on a ring of **radius** world units and alternates its colour. The camera stands inside the ring near the rim looking outward, so about five glyphs are in view while the rest slide past off screen. Each glyph casts a shadow onto the floor.\n\n**spin** sets the turning rate, **bob** floats each glyph, **size** scales them, **depth** flattens the extrusion.",
   "rect": [
    [
     -40,
     -560
    ],
    [
     680,
     420
    ]
   ]
  }
 ],
 "requiredPlugins": [
  {
   "id": "graphics.fabric.CoreNodes"
  }
 ],
 "version": {
  "beta": {}
 }
}