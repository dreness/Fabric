        ],
        "id": "548021C2-2B09-45C0-82B0-4BFE2901119C",
        "stringExpression": "in t: float;\nout m1 = 6 + 4 * sin(t * rate);\nout m2 = 4 + 3 * sin(t * rate * 0.61 + 1.3);\nout n1 = 0.6 + 0.45 * sin(t * rate * 0.83 + 0.4);\nout orientation = vec4(cos(t * spin / 2) * sin(tilt / 2),\n     cos(tilt / 2) * sin(t * spin / 2),\n     sin(tilt / 2) * sin(t * spin / 2),\n     cos(tilt / 2) * cos(t * spin / 2))",
        "nodeOffset": [
          280,
          0
        ]
      },
      "type": "graphics.fabric.CoreNodes/MathExpressionNode"
    },
