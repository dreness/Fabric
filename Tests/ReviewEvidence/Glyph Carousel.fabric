    "stringExpression": "in t: float;\nlet count = 73;\nlet angle = [t * spin + i * tau / count for i in 0..<73];\nlet pose = [\n  translate(vec3(-sin(angle[i]) * radius, bob * sin(t * 1.7 + i * 1.3), cos(angle[i]) * radius))\n  * rotateY(pi - angle[i])\n  * scale(vec3(size, size, size * depth))\n  for i in 0..<73\n];\nout glyph0 = [pose[0]];\nout glyph1 = [pose[1]];\nout glyph2 = [pose[2]];\nout glyph3 = [pose[3]];\nout glyph4 = [pose[4]];\nout glyph5 = [pose[5]];\nout glyph6 = [pose[6]];\nout glyph7 = [pose[7]];\nout glyph8 = [pose[8]];\nout glyph9 = [pose[9]];\nout glyph10 = [pose[10]];\nout glyph11 = [pose[11]];\nout glyph12 = [pose[12]];\nout glyph13 = [pose[13]];\nout glyph14 = [pose[14]];\nout glyph15 = [pose[15]];\nout glyph16 = [pose[16]];\nout glyph17 = [pose[17]];\nout glyph18 = [pose[18]];\nout glyph19 = [pose[19]];\nout glyph20 = [pose[20]];\nout glyph21 = [pose[21]];\nout glyph22 = [pose[22]];\nout glyph23 = [pose[23]];\nout glyph24 = [pose[24]];\nout glyph25 = [pose[25]];\nout glyph26 = [pose[26]];\nout glyph27 = [pose[27]];\nout glyph28 = [pose[28]];\nout glyph29 = [pose[29]];\nout glyph30 = [pose[30]];\nout glyph31 = [pose[31]];\nout glyph32 = [pose[32]];\nout glyph33 = [pose[33]];\nout glyph34 = [pose[34]];\nout glyph35 = [pose[35]];\nout glyph36 = [pose[36]];\nout glyph37 = [pose[37]];\nout glyph38 = [pose[38]];\nout glyph39 = [pose[39]];\nout glyph40 = [pose[40]];\nout glyph41 = [pose[41]];\nout glyph42 = [pose[42]];\nout glyph43 = [pose[43]];\nout glyph44 = [pose[44]];\nout glyph45 = [pose[45]];\nout glyph46 = [pose[46]];\nout glyph47 = [pose[47]];\nout glyph48 = [pose[48]];\nout glyph49 = [pose[49]];\nout glyph50 = [pose[50]];\nout glyph51 = [pose[51]];\nout glyph52 = [pose[52]];\nout glyph53 = [pose[53]];\nout glyph54 = [pose[54]];\nout glyph55 = [pose[55]];\nout glyph56 = [pose[56]];\nout glyph57 = [pose[57]];\nout glyph58 = [pose[58]];\nout glyph59 = [pose[59]];\nout glyph60 = [pose[60]];\nout glyph61 = [pose[61]];\nout glyph62 = [pose[62]];\nout glyph63 = [pose[63]];\nout glyph64 = [pose[64]];\nout glyph65 = [pose[65]];\nout glyph66 = [pose[66]];\nout glyph67 = [pose[67]];\nout glyph68 = [pose[68]];\nout glyph69 = [pose[69]];\nout glyph70 = [pose[70]];\nout glyph71 = [pose[71]];\nout glyph72 = [pose[72]]",
