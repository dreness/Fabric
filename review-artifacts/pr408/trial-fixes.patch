+// Generated by review-artifacts/pr408/make-save-probe.py from FabricDocument.fileWrapper.
+// Only the surrounding document shell is replaced; the save method is copied verbatim.
+import Foundation
+import Metal
+import Satin
+import Testing
+@testable import Fabric
+
+private final class SaveHarness: @unchecked Sendable
+{
+    struct EditingContext { let rootGraph: Graph }
+    typealias WriteConfiguration = Void
+    let editingContext: EditingContext
+    var lastWrittenGraph: (Data, URL?)?
+    init(graph: Graph) { editingContext = EditingContext(rootGraph: graph) }
+    func fileWrapper(configuration: WriteConfiguration) throws -> FileWrapper
+    {
+        // Disk edits and the snapshot belong to the same save. Serialize on
+        // the main thread with graph edits, including shader reconciliation;
+        // a background writer must wait for that snapshot before returning.
+        let write = {
+            try MainActor.assumeIsolated {
+                let graph = self.editingContext.rootGraph
+                graph.takeShaderSourcesFromDisk()
+                graph.rewriteFileReferences(relativeTo: graph.fileReferenceBaseURL)
+
+                let encoder = JSONEncoder()
+                encoder.outputFormatting = [.prettyPrinted]
+                let data = try encoder.encode(graph)
+                self.lastWrittenGraph = (data, graph.fileReferenceBaseURL)
+                return FileWrapper(regularFileWithContents: data)
+            }
+        }
+
+        if Thread.isMainThread { return try write() }
+        return try DispatchQueue.main.sync(execute: write)
+    }
+
+}
+
+@Suite("Document Save Review Regressions")
+@MainActor
+struct DocumentSaveReviewRegressionTests
+{
+    @Test("A save includes the disk shader in that same save", arguments: [false, true])
+    func saveIncludesDiskShader(background: Bool) async throws
+    {
+        let device = try #require(MTLCreateSystemDefaultDevice())
+        let context = Context(device: device, sampleCount: 1, colorPixelFormat: .bgra8Unorm,
+                              depthPixelFormat: .depth32Float, stencilPixelFormat: .invalid)
+        let graph = Graph(context: context)
+        let node = LiveImageNode(context: context)
+        graph.addNode(node)
+        let held = node.shaderSource
+        let edited = held + "\n// external edit before save\n"
+        let file = try #require(node.shaderFileURL)
+        try edited.write(to: file, atomically: false, encoding: .utf8)
+        let manager = UndoManager()
+        manager.groupsByEvent = false
+        graph.undoManager = manager
+        let document = SaveHarness(graph: graph)
+        // Hold the main queue while a worker encodes. The old async hop cannot
+        // run until after stale data has been written. A synchronous save waits.
+        let data: Data
+        if !background
+        {
+            data = try #require(try document.fileWrapper(configuration: ()).regularFileContents)
+        }
+        else
+        {
+        let started = DispatchSemaphore(value: 0)
+        let finished = DispatchSemaphore(value: 0)
+        let task = Task.detached
+        {
+            started.signal()
+            defer { finished.signal() }
+            return try document.fileWrapper(configuration: ()).regularFileContents
+        }
+        started.wait()
+        _ = finished.wait(timeout: .now() + .milliseconds(100))
+        data = try #require(try await task.value)
+        }
+        let decoder = JSONDecoder()
+        decoder.context = DecoderContext(documentContext: context)
+        let saved = try decoder.decode(Graph.self, from: data)
+        #expect((saved.node(forID: node.id) as? LiveImageNode)?.shaderSource == edited)
+        #expect(node.shaderSource == edited)
+        graph.undo()
+        #expect(node.shaderSource == held)
+    }
+}
